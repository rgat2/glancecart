{
  "name": "@glancecart/glasses",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "simulate": "evenhub-simulator http://localhost:5173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:ehpk": "tsc --noEmit && vite build && evenhub pack app.json dist -o glancecart.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "latest",
    "@glancecart/shared": "workspace:*",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "latest",
    "@evenrealities/evenhub-simulator": "latest",
    "typescript": "^5.7.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
