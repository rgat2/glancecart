# Copy to .env (gitignored). Never commit real values. TESTNET ONLY.

# Speech-to-text (apps/api). STT_PROVIDER=deepgram (default) or whisper
STT_PROVIDER=deepgram
# https://console.deepgram.com → API Keys (free credit on signup)
DEEPGRAM_API_KEY=
# Optional swap-in: any OpenAI-compatible Whisper endpoint
WHISPER_BASE_URL=
WHISPER_API_KEY=

# Intent parsing + ranking (apps/api). https://console.anthropic.com → API Keys
# Without it the API falls back to a rule-based parser (fine for the demo phrases).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Telegram bot @GlanceCartBot (apps/api). Talk to @BotFather → /newbot, paste the token here.
# Receipts, daily summary, caps, top-up and revoke. The bot long-polls; no webhook needed.
TELEGRAM_BOT_TOKEN=
# Daily summary hour in UTC (18 = 22:00 Dubai)
SUMMARY_HOUR_UTC=18

# TON testnet RPC (api + mock-store). Get a TESTNET key from @tonapibot on Telegram
TONCENTER_API_KEY=
TONCENTER_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC

# Mock store's own merchant wallet (receives payments, sends refunds). TESTNET mnemonic only.
# Generate with `pnpm --filter @glancecart/mock-store gen-wallet` (writes it here), then fund the
# printed address with ~2 test GRAM from https://t.me/testgiver_ton_bot (refund gas).
STORE_TESTNET_MNEMONIC=

# Note: the user's agent-wallet key is generated on the phone and never appears here.

# API state file (caps, spend ledger). Default: apps/api/data/state.json (gitignored)
STATE_FILE=

# Public HTTPS origin of the deployed API (used for the TON Connect manifest and /fund links)
PUBLIC_URL=
# Optional: host the funding page elsewhere (default: $PUBLIC_URL/fund/)
FUND_PUBLIC_URL=

# Glasses app build-time overrides (optional; defaults use the page's host)
# (set in apps/glasses/.env.production for the packaged .ehpk)
VITE_API_URL=
VITE_FUND_URL=
# Fund page: public HTTPS URL of tonconnect-manifest.json (default: same origin, served by the API)
VITE_TC_MANIFEST_URL=

# Local ports / URLs
API_PORT=8787
STORE_PORT=8788
STORE_URL=http://localhost:8788
